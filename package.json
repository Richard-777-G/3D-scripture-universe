{
  "name": "scripture-universe",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "npm run packs && vite",
    "packs": "node pipeline/build-packs.mjs",
    "validate": "node pipeline/build-packs.mjs --check",
    "build": "npm run packs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:db": "tests/db/run.sh",
    "export-db": "node pipeline/export-db.mjs",
    "fetch": "node pipeline/fetch.mjs",
    "evidence:review": "node pipeline/evidence-review.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.0",
    "@types/leaflet": "1.9.12",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "maplibre-gl": "5.13.0",
    "pmtiles": "4.3.0",
    "react": "18.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "18.3.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
